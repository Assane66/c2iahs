rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow read/write access to all collections for any authenticated user.
    // This is a good starting point, but you should refine these rules
    // to be more specific (e.g., only admins can write to 'users').
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // Specific rules for collections can be added here.
    // For example, to make the 'students' collection readable by anyone
    // but only writable by authenticated users:
    //
    // match /students/{studentId} {
    //   allow read: if true;
    //   allow write: if request.auth != null;
    // }
  }
}
